# WearLensAI environment — copy to .env and fill in. Never commit .env.

# fal.ai API key (required for the API benchmark + demo)
# Create one at: https://fal.ai/dashboard/keys
FAL_KEY=

# --- Web app deploy (Phase 3 Step 8) — full runbook: docs/deploy.md ---
# Unset = offline dev defaults (local disk + sqlite). All free tiers.

# Job rows: "sqlite" (dev) or "neon" (deploy). Neon needs DATABASE_URL.
TRYON_JOBS=
# Neon connection string (Dashboard → project → Connection string)
DATABASE_URL=

# Images: "local" (dev) or "r2" (deploy). R2 needs the five R2_* vars.
TRYON_STORAGE=
# Cloudflare dashboard → R2 → your bucket (Settings tab for the public URL)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

